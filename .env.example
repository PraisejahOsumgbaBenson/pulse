# Copy to .env and fill in. Never commit the real file.
# Pulse loads .env from the working directory at startup. Real environment
# variables win, so a container or process manager can override the file.
# cp .env.example .env

# Telegram bot token from @BotFather. Send /newbot, follow the prompts,
# paste the token here.
TELEGRAM_TOKEN=

# Optional: lock every command to one Telegram user id. Leave empty and the
# first user to run /start becomes the owner. Get your id from @userinfobot.
TELEGRAM_OWNER_ID=

# LinkedIn developer app credentials, Auth tab. Optional: leave the three
# lines empty and the bot still reminds and drafts; /link explains itself.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Exact callback URL registered in the app's Auth settings, e.g.
# http://localhost:8081/oauth/linkedin/callback for local runs, or
# https://your-host/oauth/linkedin/callback on a public server with HTTPS.
LINKEDIN_REDIRECT_URI=
# YYYYMM Posts API version header. Update yearly.
LINKEDIN_API_VERSION=202602

# Where the tiny OAuth callback server listens.
OAUTH_ADDR=:8081

# Draft generation. Any OpenAI-compatible endpoint works. Leave LLM_API_KEY
# empty to use the built-in offline fallback generator. Free AI drafts:
# create a key at https://aistudio.google.com, then set
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai and
# LLM_MODEL to a current flash model (e.g. gemini-3.5-flash-lite).
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Optional voice hint, e.g. "warm and encouraging, short sentences".
LLM_STYLE=

# SQLite file, created on first run. Leave unset for pulse.db in the current
# directory. Docker Compose sets DB_PATH=/data/pulse.db on the named volume.
# DB_PATH=pulse.db

# IANA timezone schedules run in, e.g. Europe/Berlin or Africa/Lagos.
# Set this explicitly. Containers have no local timezone and fall back to UTC.
TIMEZONE=UTC

# debug, info, warn, error.
LOG_LEVEL=info
