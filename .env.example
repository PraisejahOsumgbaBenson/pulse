# Copy to .env and fill in. Never commit the real file.
# cp .env.example .env

# Discord bot token from the Discord Developer Portal, Bot tab.
DISCORD_TOKEN=

# Optional: lock every command to one Discord user id. Leave empty and the
# first user to run /link or /schedule-set becomes the owner.
DISCORD_OWNER_ID=

# Optional: register slash commands to one guild id for instant testing.
# Empty means global registration, which can take up to an hour to appear.
DEV_GUILD_ID=

# LinkedIn developer app credentials, Auth tab.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Exact callback URL registered in the app's Auth settings, e.g.
# http://localhost:8081/oauth/linkedin/callback for local runs.
LINKEDIN_REDIRECT_URI=
# YYYYMM Posts API version header. Update yearly.
LINKEDIN_API_VERSION=202602

# Where the tiny OAuth callback server listens.
OAUTH_ADDR=:8081

# Draft generation. Any OpenAI-compatible endpoint works. Leave LLM_API_KEY
# empty to use the built-in offline fallback generator.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# Optional voice hint, e.g. "warm and encouraging, short sentences".
LLM_STYLE=

# SQLite file, created on first run.
DB_PATH=pulse.db

# IANA timezone schedules run in, e.g. Europe/Berlin. Default is server local.
TIMEZONE=Local

# debug, info, warn, error.
LOG_LEVEL=info
